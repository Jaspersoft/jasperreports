	<group name="Stacked" startNewPage="true">
		<groupHeader>
			<band height="80">
				<element kind="staticText" uuid="97664c1d-2990-5cd4-95f7-95f47b92fd37" x="0" y="0" width="515" height="30" style="Section Title">
					<text><![CDATA[Stacked barcodes]]></text>
				</element>
				<element kind="staticText" uuid="98a68444-3690-5a95-860a-99859b8bda21" x="0" y="35" width="515" height="40" style="Section Note">
					<text><![CDATA[Rows of linear barcode stacked on top of each other. PDF417 and Codablock F rows share the element height, but they are never lower than the symbology allows; Code 16K and Code 49 have a fixed shape and fill the element keeping it.]]></text>
				</element>
			</band>
			<band height="165">
				<element kind="line" uuid="2eaf7f31-ba23-5bf9-850f-6a40e4a1118c" x="0" y="0" width="515" height="1"/>
				<element kind="staticText" uuid="bfa29243-5c11-5eb6-a156-47b98b9abc88" x="0" y="5" width="515" height="20" style="Type Title">
					<text><![CDATA[kind="okapi:PDF417"]]></text>
				</element>
				<element kind="staticText" uuid="a485f613-d0e5-5276-b4cb-7cbcfe5052c3" x="0" y="25" width="515" height="28" style="Type Note">
					<text><![CDATA[Any text; HIBC data. Truncated PDF417 drops the right row indicators, MicroPDF417 is a smaller variant for short data. Macro PDF417 splits a message over several symbols. Code: "JasperReports".]]></text>
				</element>
				<element kind="staticText" uuid="fc3a2fc1-80f8-5d90-a501-8475abdbeea1" x="0" y="58" width="165" height="27" style="Caption">
