					<text><![CDATA[Postal barcodes]]></text>
				</element>
				<element kind="staticText" uuid="0b626064-4735-5288-be65-0a6942897d13" x="0" y="35" width="515" height="40" style="Section Note">
					<text><![CDATA[Barcodes printed on mail. The four-state codes of Royal Mail, KIX, Japan Post and Australia Post have a fixed shape and no moduleWidth: they fill the element, keeping their shape.]]></text>
				</element>
			</band>
