					<xs:attribute name="displayStartStop" type="xs:boolean"/>
					<xs:attribute name="drawText" type="xs:boolean"/>
					<xs:attribute name="errorCorrectionLevel" type="xs:string"/>
					<xs:attribute name="evaluationGroup" type="xs:string">
						<xs:annotation>
							<xs:documentation>Used to specify the group at which to evaluate the element expressions, when evaluationTime is "Group".</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="evaluationTime" type="EvaluationTime">
						<xs:annotation>
							<xs:documentation>The moment at which the element expressions are evaluated. This could be useful, for example, when we want to have on the first page the total number of pages: the total number of pages is known only after filling the entire report, so the text field that displays it at the beginning of the report should be evaluated only when reaching the end of the report.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="extendedCharSetEnabled" type="xs:boolean"/>
					<xs:attribute name="hAlign" type="HorizontalImageAlign">
						<xs:annotation>
							<xs:documentation>Horizontal image alignment.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="horizontalPosition" type="HorizontalPosition"/>
					<xs:attribute name="iconPosition">
						<xs:annotation>
							<xs:documentation>Icon position.</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:annotation>
								<xs:appinfo>net.sf.jasperreports.components.iconlabel.IconPositionEnum</xs:appinfo>
							</xs:annotation>
							<xs:restriction base="xs:string">
								<xs:enumeration value="Start"/>
								<xs:enumeration value="End"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="intercharGapWidth" type="xs:double"/>
					<xs:attribute name="labelFill">
						<xs:annotation>
							<xs:documentation>Text fill policy.</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:annotation>
								<xs:appinfo>net.sf.jasperreports.components.iconlabel.ContainerFillEnum</xs:appinfo>
							</xs:annotation>
							<xs:restriction base="xs:string">
								<xs:enumeration value="None"/>
								<xs:enumeration value="Horizontal"/>
								<xs:enumeration value="Vertical"/>
								<xs:enumeration value="Both"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="margin" type="xs:int"/>
					<xs:attribute name="maxColumns" type="xs:int"/>
					<xs:attribute name="maxRows" type="xs:int"/>
					<xs:attribute name="maxSymbolHeight" type="xs:int"/>
					<xs:attribute name="maxSymbolWidth" type="xs:int"/>
					<xs:attribute name="minColumns" type="xs:int"/>
					<xs:attribute name="minRows" type="xs:int"/>
					<xs:attribute name="minSymbolHeight" type="xs:int"/>
					<xs:attribute name="minSymbolWidth" type="xs:int"/>
					<xs:attribute name="moduleWidth" type="xs:double"/>
					<xs:attribute name="orientation">
						<xs:simpleType>
							<xs:annotation>
								<xs:appinfo>net.sf.jasperreports.barcode4j.OrientationEnum</xs:appinfo>
							</xs:annotation>
							<xs:restriction base="xs:string">
								<xs:enumeration value="up"/>
								<xs:enumeration value="left"/>
								<xs:enumeration value="down"/>
								<xs:enumeration value="right"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="printOrder" type="PrintOrder"/>
					<xs:attribute name="qrVersion" type="xs:int"/>
					<xs:attribute name="quietZone" type="xs:double"/>
					<xs:attribute name="rotation" type="Rotation">
						<xs:annotation>
							<xs:documentation>Type of orientation for the barcode object.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="shape" type="xs:string"/>
					<xs:attribute name="shortBarHeight" type="xs:double"/>
					<xs:attribute name="shrinkWidth" type="xs:boolean"/>
					<xs:attribute name="style" type="xs:string">
						<xs:annotation>
							<xs:documentation>Name of the report level style to use as base style (see style element).</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="textPosition">
						<xs:simpleType>
							<xs:annotation>
								<xs:appinfo>net.sf.jasperreports.barcode4j.TextPositionEnum</xs:appinfo>
							</xs:annotation>
							<xs:restriction base="xs:string">
								<xs:enumeration value="none"/>
								<xs:enumeration value="bottom"/>
								<xs:enumeration value="top"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="trackHeight" type="xs:double"/>
					<xs:attribute name="type" type="xs:string"/>
					<xs:attribute name="vAlign" type="VerticalImageAlign">
						<xs:annotation>
							<xs:documentation>Vertical image alignment.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="verticalQuietZone" type="xs:double"/>
					<xs:attribute name="whenNoDataType">
						<xs:annotation>
							<xs:documentation>Allows users to customize the behavior of the table when there are now rows in the data source.</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:annotation>
								<xs:appinfo>net.sf.jasperreports.components.table.WhenNoDataTypeTableEnum</xs:appinfo>
							</xs:annotation>
							<xs:restriction base="xs:string">
								<xs:enumeration value="Blank">
									<xs:annotation>
										<xs:documentation>The table output will be blank.</xs:documentation>
									</xs:annotation>
								</xs:enumeration>
								<xs:enumeration value="NoDataCell">
									<xs:annotation>
										<xs:documentation>The table output consists of only the noData cell.</xs:documentation>
									</xs:annotation>
								</xs:enumeration>
								<xs:enumeration value="AllSectionsNoDetail"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="wideFactor" type="xs:double"/>
					<xs:attribute name="widthToHeightRatio" type="xs:double"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="connectionExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>If present, it is used to pass the java.sql.Connection object to the subreport filling or subdataset iteration routines.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dataSourceExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>If present, it is used to pass the net.sf.jasperreports.engine.JRDataSource object to the subreport filling or subdataset iteration routines.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dataset">
				<xs:annotation>
					<xs:documentation>Dataset definition for a chart or crosstab.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="element" type="AnyChild"/>
			<xs:element name="expression" type="Expression">
				<xs:annotation>
					<xs:documentation>Definition of the expression that will be used to determine the image to be displayed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="genericType">
				<xs:complexType>
					<xs:annotation>
						<xs:appinfo>net.sf.jasperreports.engine.JRGenericElementType</xs:appinfo>
					</xs:annotation>
					<xs:attribute name="name" type="xs:string"/>
					<xs:attribute name="namespace" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="headerCell" type="CellContents">
				<xs:annotation>
					<xs:documentation>Crosstab cell that will be rendered at the upper-left corner of the crosstab. The cell size will be calculated based on the row/column header cell widths/heights.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="hyperlinkAnchorExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Used in hyperlink elements to point to document anchors.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="hyperlinkPageExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Used in hyperlink elements to point to document pages.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="hyperlinkParameter" type="HyperlinkParameter">
				<xs:annotation>
					<xs:documentation>Definition of a hyperlink parameter. Hyperlink parameters can be used to parametrize hyperlinks of custom types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="hyperlinkReferenceExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Used in hyperlink elements to point to external documents and resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="hyperlinkTooltipExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Used in hyperlink elements to generate a tooltip for the hyperlink. The type of the expression should be java.lang.String.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="hyperlinkWhenExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Used in hyperlink elements to specify whether the hyperlink is to be displayed or not.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="legendFont" type="Font"/>
			<xs:element name="measure">
				<xs:annotation>
					<xs:documentation>Crosstab measure definition. A measure is a value accumulated by the crosstab calculation engine and displayed in the crosstab data cells. Each measure in the crosstab has a variable that can be used inside the data cells as the current measure value. The variable has the same name and type as the measure. Variables representing totals at different levels are also available. The names of these variables are: &lt;Measure&gt;_&lt;Row/Column Group&gt;_ALL - the total for the column/row group &lt;Measure&gt;_&lt;Row Group&gt;_&lt;Column Group&gt;_ALL - the combined total for the column and row groups For instance, if one defines "Year" and "Month" column groups, a "City" row group and a "Sales" measure, then: Sales_Month_ALL will hold the total for all months (i.e. for one year) Sales_City_Month_ALL will hold the total for all months (one year) and all cities Sales_City_Year_ALL will hold the grand total</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:annotation>
						<xs:appinfo>net.sf.jasperreports.crosstabs.JRCrosstabMeasure</xs:appinfo>
					</xs:annotation>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element name="expression" type="Expression">
							<xs:annotation>
								<xs:documentation>Crosstab measure expression.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:choice>
					<xs:attribute name="calculation" type="Calculation">
						<xs:annotation>
							<xs:documentation>The calculation type to be performed on the measure values.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="class" type="xs:string">
						<xs:annotation>
							<xs:documentation>The measure values class.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="incrementerFactoryClass" type="xs:string">
						<xs:annotation>
							<xs:documentation>The name of a class that implements the net.sf.jasperreports.engine.fill.JRIncrementerFactory interface to use when creating the incrementer instance for this measure. Incrementers are objects that implement the net.sf.jasperreports.engine.fill.JRIncrementer interface and handle the incremental calculation performed on the measure's current value with every entry in the crosstab dataset.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="name" type="xs:string">
						<xs:annotation>
							<xs:documentation>Measure name.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="percentageCalculatorClass" type="xs:string">
						<xs:annotation>
							<xs:documentation>The percentage calcualtor class name. The class should implement the net.sf.jasperreports.crosstabs.fill.JRPercentageCalculator interface.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="percentageType">
						<xs:simpleType>
							<xs:annotation>
								<xs:appinfo>net.sf.jasperreports.crosstabs.type.CrosstabPercentageEnum</xs:appinfo>
							</xs:annotation>
							<xs:restriction base="xs:string">
								<xs:enumeration value="None"/>
								<xs:enumeration value="GrandTotal"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
			<xs:element name="paragraph" type="Paragraph">
				<xs:annotation>
					<xs:documentation>Paragraph properties for text elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="parameter">
				<xs:annotation>
					<xs:documentation>Crosstab parameter definition and value. Values from the report can only be accessed inside crosstab elements by passing them as parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="parametersMapExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Allows bulk passing the parameters to the subreport/subdataset into a java.lang.Map object. There are cases when we want to pass to the subreport/subdataset the same parameters that the master report has received. This can be achieved by passing the system-defined parameter called REPORT_PARAMETERS_MAP and maybe adding to or overriding those parameters using additional subreportParameter elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="patternExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Defines the pattern expression to use for this textField.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="pen" type="Pen">
				<xs:annotation>
					<xs:documentation>Groups the properties of the pen used to draw lines or borders.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="plot">
				<xs:annotation>
					<xs:documentation>Defines generic plot options for charts</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="printWhenExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Definition of a Boolean expression that will determine if the element or the band should be printed or not.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="property" type="Property">
				<xs:annotation>
					<xs:documentation>Allows the creation of a name-value pair property for a report object (e.g. the report itself, a field, a parameter, etc).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="propertyExpression" type="PropertyExpression">
				<xs:annotation>
					<xs:documentation>Allows the creation of a dynamic name-value pair property for a report element. The contents of this element is interpreted as a java.lang.String expression, which will be evaluated at fill time, the result being used as property value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="returnValue" type="SubreportReturnValue">
				<xs:annotation>
					<xs:documentation>Maps a subreport variable to a master report variable in order to allow returning values from subreport to the master report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="rowGroup">
				<xs:annotation>
					<xs:documentation>Crosstab row group definition. Each group in the crosstab has a variable that can be used inside the group header or inside the crosstab cells as the current group value. The variable has the same name as the group and the same type as the bucket expression of the group.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:annotation>
						<xs:appinfo>net.sf.jasperreports.crosstabs.JRCrosstabRowGroup</xs:appinfo>
					</xs:annotation>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element name="bucket" type="CrosstabBucket">
							<xs:annotation>
								<xs:documentation>Crosstab group bucketing information.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="header" type="CellContents"/>
						<xs:element name="mergeHeaderCells" type="xs:boolean"/>
						<xs:element name="totalHeader" type="CellContents"/>
					</xs:choice>
					<xs:attribute name="keepTogether" type="xs:boolean"/>
					<xs:attribute name="name" type="xs:string">
						<xs:annotation>
							<xs:documentation>Group name.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="position">
						<xs:simpleType>
							<xs:annotation>
								<xs:appinfo>net.sf.jasperreports.crosstabs.type.CrosstabRowPositionEnum</xs:appinfo>
							</xs:annotation>
							<xs:restriction base="xs:string">
								<xs:enumeration value="Top"/>
								<xs:enumeration value="Middle"/>
								<xs:enumeration value="Bottom"/>
								<xs:enumeration value="Stretch"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="totalPosition" type="CrosstabTotalPosition">
						<xs:annotation>
							<xs:documentation>The position of the total row for this group. A group can have a total row summing the values for all the entries in the group. E.g. if there is a Year group having Month as a subgroup, the total row for the Year group would sum the values for all the years and the total row for the Month group would sum the values for all the months of an year.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="width" type="xs:int">
						<xs:annotation>
							<xs:documentation>The width of the row group header.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
			<xs:element name="styleExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Expression providing the name of a style definition to be used for the element at runtime.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="subtitleExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Defines the expression for the chart subtitle</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="subtitleFont" type="Font"/>
			<xs:element name="text" type="xs:string">
				<xs:annotation>
					<xs:documentation>Specifies the text to print for a static text object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="titleCell">
				<xs:complexType>
					<xs:annotation>
						<xs:appinfo>net.sf.jasperreports.crosstabs.CrosstabColumnCell</xs:appinfo>
					</xs:annotation>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element name="cellContents" type="CellContents">
							<xs:annotation>
								<xs:documentation>Crosstab header or data cell contents. There are some restrictions/rules regarding crosstab cells: Subreports, crosstabs and charts are not allowed. Delayed evaluation for text fields and images is not allowed. Cells cannot split on multiple pages.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:choice>
					<xs:attribute name="contentsPosition" type="CrosstabColumnPosition"/>
					<xs:attribute name="height" type="xs:int"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="titleExpression" type="Expression">
				<xs:annotation>
					<xs:documentation>Title expression of the chart</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="titleFont" type="Font"/>
			<xs:element name="whenNoDataCell" type="CellContents">
				<xs:annotation>
					<xs:documentation>Crosstab cell that will be rendered when no data was fed to the crosstab. If this cell is not specified for a crosstab, nothing will be rendered for an empty crosstab. The cell size is the same as the crosstab element size.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
		<xs:attribute name="kind" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="break"/>
					<xs:enumeration value="chart"/>
					<xs:enumeration value="component"/>
					<xs:enumeration value="crosstab"/>
					<xs:enumeration value="elementGroup"/>
					<xs:enumeration value="ellipse"/>
					<xs:enumeration value="frame"/>
					<xs:enumeration value="generic"/>
					<xs:enumeration value="image"/>
					<xs:enumeration value="line"/>
					<xs:enumeration value="rectangle"/>
					<xs:enumeration value="staticText"/>
					<xs:enumeration value="subreport"/>
					<xs:enumeration value="textField"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="chartType">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="area"/>
					<xs:enumeration value="bar3D"/>
					<xs:enumeration value="bar"/>
					<xs:enumeration value="bubble"/>
					<xs:enumeration value="candlestick"/>
					<xs:enumeration value="highLow"/>
					<xs:enumeration value="line"/>
					<xs:enumeration value="pie3D"/>
					<xs:enumeration value="pie"/>
					<xs:enumeration value="scatter"/>
					<xs:enumeration value="stackedBar3D"/>
					<xs:enumeration value="stackedBar"/>
					<xs:enumeration value="xyArea"/>
					<xs:enumeration value="xyBar"/>
					<xs:enumeration value="xyLine"/>
					<xs:enumeration value="timeSeries"/>
					<xs:enumeration value="meter"/>
					<xs:enumeration value="thermometer"/>
					<xs:enumeration value="multiAxis"/>
					<xs:enumeration value="stackedArea"/>
					<xs:enumeration value="gantt"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="backcolor" type="Color">
			<xs:annotation>
				<xs:documentation>Back color to use when drawing the object. Hexadecimal formatted values preceded by the # character or decimal values are accepted along with the following predefined color values: black, blue, cyan, darkGray, gray, green, lightGray, magenta, orange, pink, red, yellow, white.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="blankWhenNull" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Specifies that the text field should display a blank character instead of "null" when the text field expression evaluates to null.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="bold" type="xs:boolean"/>
		<xs:attribute name="bookmarkLevel" type="xs:int">
			<xs:annotation>
				<xs:documentation>The level of the bookmark corresponding to the anchor. The PDF exporter can create a bookmark tree using anchors defined in the report. This attribute specifies the level of the tree entry corresponding to this element's anchor. If set to "0" (the default), no bookmark will be created for the anchor.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="columnBreakOffset" type="xs:int">
			<xs:annotation>
				<xs:documentation>Offset used when a column break occurs and the filling is continued on the same page. When the crosstab columns do not fit the width, the crosstab breaks the columns and prints the ones that don't fit after printing the first set of columns for all rows. This attribute is the offset to be used when continuing the printing after a column break.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="customizerClass" type="xs:string">
			<xs:annotation>
				<xs:documentation>The name of the chart customizer class. A chart can have an associated customizer class to perform customizations that are not directly supported by JRXML. The customizer class should implement net.sf.jasperreports.engine.JRChartCustomizer. At fill time, the customize() method of this class will be called before the chart is rendered. If values of report parameters, variables or fields are needed in the customization, the customizer implementation should extend net.sf.jasperreports.engine.JRAbstractChartCustomizer to gain access to such values.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="direction">
			<xs:annotation>
				<xs:documentation>Lines are drawn as diagonals of the rectangle defined by the report element properties. This attribute specifies which of the two diagonals should be drawn.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:annotation>
					<xs:appinfo>net.sf.jasperreports.engine.type.LineDirectionEnum</xs:appinfo>
				</xs:annotation>
				<xs:restriction base="xs:string">
					<xs:enumeration value="TopDown">
						<xs:annotation>
							<xs:documentation>The diagonal that starts in the top-left corner of the rectangle will be drawn.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="BottomUp">
						<xs:annotation>
							<xs:documentation>The diagonal that starts in the bottom-left corner of the rectangle will be drawn.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="evaluationGroup" type="xs:string">
			<xs:annotation>
				<xs:documentation>Used to specify the group at which to evaluate the element expressions, when evaluationTime is "Group".</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="evaluationTime" type="EvaluationTime">
			<xs:annotation>
				<xs:documentation>The moment at which the element expressions are evaluated. This could be useful, for example, when we want to have on the first page the total number of pages: the total number of pages is known only after filling the entire report, so the text field that displays it at the beginning of the report should be evaluated only when reaching the end of the report.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="fill" type="Fill">
			<xs:annotation>
				<xs:documentation>Type of the fill pattern used to fill objects.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="fontName" type="xs:string">
			<xs:annotation>
				<xs:documentation>Name of the font.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="fontSize" type="xs:float"/>
		<xs:attribute name="forecolor" type="Color">
			<xs:annotation>
				<xs:documentation>Fore color to use when drawing the object. Hexadecimal formatted values preceded by the # character or decimal values are accepted along with the following predefined color values: black, blue, cyan, darkGray, gray, green, lightGray, magenta, orange, pink, red, yellow, white.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="hImageAlign" type="HorizontalImageAlign"/>
		<xs:attribute name="hTextAlign" type="HorizontalTextAlign"/>
		<xs:attribute name="height" type="xs:int">
			<xs:annotation>
				<xs:documentation>Height of the object.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="horizontalPosition" type="HorizontalPosition">
			<xs:annotation>
				<xs:documentation>The position of the crosstab within its element box. By default LTR crosstabs are positions at the left of the element box, and RTL crosstabs at the right of the box.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="ignoreWidth" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>This attribute determines whether the crosstab will break at the width set for the crosstab element, or whether the crosstab is to expand over this width (and over the page width as well). If this attribute is set to true, the crosstab will expand towards the right (or towards the left if the crosstab direction is RTL) as long as it needs to. This would result in crosstab cells being rendered over the page boundary; such elements will be exported by certain grid-based exporters such as the HTML or XLS ones, but will not be visible in export formats that observe the page width, such as the PDF exporter. The default value of this flag is given by the net.sf.jasperreports.crosstab.ignore.width property.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="italic" type="xs:boolean"/>
		<xs:attribute name="key" type="xs:string">
			<xs:annotation>
				<xs:documentation>This attribute is used to identify band elements by their "key" when wanting to alter their settings at runtime. The key value must be unique for elements within report band.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="lazy" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Gives control over when the images are retrieved from their specified location.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="legendBackgroundColor" type="Color"/>
		<xs:attribute name="legendColor" type="Color"/>
		<xs:attribute name="legendPosition" type="Edge"/>
		<xs:attribute name="linkTarget" type="xs:string"/>
		<xs:attribute name="linkType" type="xs:string"/>
		<xs:attribute name="markup" type="xs:string">
			<xs:annotation>
				<xs:documentation>Specifies the name of the markup language used to embed style information into the text content. Supported values are none (plain text), styled (styled text), rtf (RTF format) and html (HTML format), but any custom made markup language can be used as long as there is a net.sf.jasperreports.engine.util.MarkupProcessorFactory implementation specified using a net.sf.jasperreports.markup.processor.factory.{markup} configuration property.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="mode" type="Mode">
			<xs:annotation>
				<xs:documentation>Specifies whether the background of an object is transparent or opaque.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="onErrorType">
			<xs:annotation>
				<xs:documentation>Controls the behavior of the engine in case the image is not available.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:annotation>
					<xs:appinfo>net.sf.jasperreports.engine.type.OnErrorTypeEnum</xs:appinfo>
				</xs:annotation>
				<xs:restriction base="xs:string">
					<xs:enumeration value="Error">
						<xs:annotation>
							<xs:documentation>An exception is raised when loading the image.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="Blank">
						<xs:annotation>
							<xs:documentation>The exception is ignored and the image displays as blank.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="Icon">
						<xs:annotation>
							<xs:documentation>The exception is ignored and an image replacement icon is displayed.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="overflowType">
			<xs:annotation>
				<xs:documentation>Determines what happens when the subreport contents overflows the element height. If not specified, the subreport will stretch to accomodate the contents.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:annotation>
					<xs:appinfo>net.sf.jasperreports.engine.type.OverflowType</xs:appinfo>
				</xs:annotation>
				<xs:restriction base="xs:string">
					<xs:enumeration value="Stretch">
						<xs:annotation>
							<xs:documentation>The subreport stretches to to accomodate the overflown contents.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="NoStretch">
						<xs:annotation>
							<xs:documentation>The contents do not stretch beyond the subreport element height. The band on which the subreport is placed overflows to a new page if allowed, and the subreport contents continues there.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="pattern" type="xs:string">
			<xs:annotation>
				<xs:documentation>Pattern to use when formatting the output of the text field expression.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="pdfEmbedded" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Specifies if the PDF font should be embedded in the document.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="pdfEncoding" type="xs:string">
			<xs:annotation>
				<xs:documentation>Encoding type to use with the PDF font.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="pdfFontName" type="xs:string">
			<xs:annotation>
				<xs:documentation>Name of the PDF font.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="positionType" type="PositionType">
			<xs:annotation>
				<xs:documentation>Specifies the object position when the report section is affected by stretch.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="printInFirstWholeBand" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>The element gets printed in the first band of a new page or column that is not an overflow from a previous page or column.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="printRepeatedValues" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>This flag allows suppressing the repeating values for the dynamic elements such as text fields and image fields and to fully customize the behavior of the static elements like rectangles, lines, ellipses and static texts.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="printWhenDetailOverflows" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>The element will be printed when the band overflows to a new page or a new column.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="printWhenGroupChanges" type="xs:string">
			<xs:annotation>
				<xs:documentation>The element will be printed when the specified group changes.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="radius" type="xs:int">
			<xs:annotation>
				<xs:documentation>The radius of the arc corner.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="removeLineWhenBlank" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Collapses the band if the element is not printing and no other element is occupying the same horizontal space.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="renderType" type="xs:string">
			<xs:annotation>
				<xs:documentation>Represents the specified format used to render the chart.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="repeatColumnHeaders" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that indicates whether the column headers will be reprinted after a page break.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="repeatRowHeaders" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that indicates whether the row headers will be reprinted after a crosstab column break.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="rotation" type="Rotation">
			<xs:annotation>
				<xs:documentation>Type of rotation for the image object.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="runDirection" type="RunDirection">
			<xs:annotation>
				<xs:documentation>The crosstab run direction. Crosstabs can either be filled from left to right (the default) or from right to left (mainly for reports in RTL languages). When a crosstab is filled from right to left, the crosstab contents will start from the right extremity of the crosstab element area and grow towards the left.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="runToBottom" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag to specify if the subreport should consume all the available space on the current page. When this flag is set, the subreport would consume the entire vertical space available on the master page, and its column and page footers will be printed at the bottom of this space.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="scaleImage" type="ScaleImage">
			<xs:annotation>
				<xs:documentation>Image displaying type.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="showLegend" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Show legend flag</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="stretchType" type="StretchType">
			<xs:annotation>
				<xs:documentation>Specifies the element stretch behavior relative to its element group siblings or element container stretch.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="strikeThrough" type="xs:boolean"/>
		<xs:attribute name="style" type="xs:string">
			<xs:annotation>
				<xs:documentation>Name of the report level style to use as base style (see style element).</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="subtitleColor" type="Color"/>
		<xs:attribute name="textAdjust" type="TextAdjust">
			<xs:annotation>
				<xs:documentation>Text adjust type.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="theme" type="xs:string">
			<xs:annotation>
				<xs:documentation>The chart theme used to draw the chart.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="titleColor" type="Color"/>
		<xs:attribute name="titlePosition" type="Edge"/>
		<xs:attribute name="type">
			<xs:annotation>
				<xs:documentation>Specifies the type of the break element.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:annotation>
					<xs:appinfo>net.sf.jasperreports.engine.type.BreakTypeEnum</xs:appinfo>
				</xs:annotation>
				<xs:restriction base="xs:string">
					<xs:enumeration value="Page">
						<xs:annotation>
							<xs:documentation>Page break.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="Column">
						<xs:annotation>
							<xs:documentation>Column break.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="underline" type="xs:boolean"/>
		<xs:attribute name="usingCache" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>If true, tells the report engine to cache the images that are loaded from the same location.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="uuid" type="Uuid"/>
		<xs:attribute name="vImageAlign" type="VerticalImageAlign"/>
		<xs:attribute name="vTextAlign" type="VerticalTextAlign"/>
		<xs:attribute name="width" type="xs:int">
			<xs:annotation>
				<xs:documentation>Width of the object.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="x" type="xs:int">
			<xs:annotation>
				<xs:documentation>Specifies the x coordinate for the object within the band.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="y" type="xs:int">
			<xs:annotation>
				<xs:documentation>Specifies the y coordinate for the object within the band.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
</xs:schema>
