			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="x" type="xs:int">
			<xs:annotation>
				<xs:documentation>Specifies the x coordinate for the object within the band.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="y" type="xs:int">
