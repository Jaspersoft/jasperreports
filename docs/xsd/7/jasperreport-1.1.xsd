					<xs:documentation>Dataset definition for a chart or crosstab.</xs:documentation>
				</xs:annotation>
				<xs:alternative test="@kind = 'category'" type="CategoryDataset"/>
				<xs:alternative test="@kind = 'gantt'" type="GanttDataset"/>
				<xs:alternative test="@kind = 'highLow'" type="HighLowDataset"/>
				<xs:alternative test="@kind = 'pie'" type="PieDataset"/>
				<xs:alternative test="@kind = 'timePeriod'" type="TimePeriodDataset"/>
				<xs:alternative test="@kind = 'timeSeries'" type="TimeSeriesDataset"/>
				<xs:alternative test="@kind = 'value'" type="ValueDataset"/>
