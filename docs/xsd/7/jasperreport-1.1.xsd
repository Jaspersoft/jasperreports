		<xs:attribute name="style" type="xs:string">
			<xs:annotation>
				<xs:documentation>Name of the report level style to use as base style (see style element).</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="subtitleColor" type="Color"/>
		<xs:attribute name="theme" type="xs:string">
			<xs:annotation>
				<xs:documentation>The chart theme used to draw the chart.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="titleColor" type="Color"/>
		<xs:attribute name="titlePosition" type="Edge"/>
		<xs:attribute name="uuid" type="Uuid"/>
		<xs:attribute name="width" type="xs:int">
			<xs:annotation>
				<xs:documentation>Width of the object.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="x" type="xs:int">
			<xs:annotation>
				<xs:documentation>Specifies the x coordinate for the object within the band.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
