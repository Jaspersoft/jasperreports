					<xs:documentation>Contains the definition of the header section for this group.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
		<xs:attribute name="footerPosition">
			<xs:annotation>
				<xs:documentation>Specifies how the group footer section behaves with regards to its position on the current page.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:annotation>
					<xs:appinfo>net.sf.jasperreports.engine.type.FooterPositionEnum</xs:appinfo>
				</xs:annotation>
				<xs:restriction base="xs:string">
					<xs:enumeration value="Normal">
						<xs:annotation>
							<xs:documentation>The group footer section is rendered at normal position, just right after the last detail or right after the nested group footer section.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="StackAtBottom">
						<xs:annotation>
							<xs:documentation>The group footer section is rendered at bottom of the current page, provided that an inner group having this value would force outer group footers to stack at the bottom of the current page, regardless of the outer group footer setting.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="ForceAtBottom">
						<xs:annotation>
							<xs:documentation>The group footer section is rendered at bottom of the current page, provided that an inner group having this value would render its footer right at the bottom of the page, forcing the outer group footers to render on the next page.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="CollateAtBottom">
						<xs:annotation>
							<xs:documentation>The group footer section is rendered at bottom of the current page, provided that the outer footers have a similar footer display option to render at the page bottom as well, because otherwise, they cannot be forced to change their behavior in any way.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
