						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="valueAxisLabelColor" type="Color"/>
					<xs:attribute name="valueAxisLineColor" type="Color"/>
					<xs:attribute name="valueAxisTickLabelColor" type="Color"/>
					<xs:attribute name="valueAxisTickLabelMask" type="xs:string"/>
					<xs:attribute name="valueAxisVerticalTickLabels" type="xs:boolean"/>
				</xs:complexType>
