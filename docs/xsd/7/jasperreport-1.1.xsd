										<xs:alternative test="@chartType = 'pie3D'" type="Pie3DChart"/>
										<xs:alternative test="@chartType = 'pie'" type="PieChart"/>
										<xs:alternative test="@chartType = 'scatter'" type="ScatterChart"/>
										<xs:alternative test="@chartType = 'stackedBar3D'" type="Bar3DChart">
											<xs:annotation>
												<xs:documentation>Defines a stacked bar chart with 3D effect</xs:documentation>
												<xs:appinfo>net.sf.jasperreports.charts.JRChart (chartType=stackedBar3D)</xs:appinfo>
											</xs:annotation>
										</xs:alternative>
										<xs:alternative test="@chartType = 'stackedBar'" type="BarChart">
											<xs:annotation>
												<xs:documentation>Defines a stacked bar chart</xs:documentation>
												<xs:appinfo>net.sf.jasperreports.charts.JRChart (chartType=stackedBar)</xs:appinfo>
											</xs:annotation>
										</xs:alternative>
										<xs:alternative test="@chartType = 'xyArea'" type="AreaChart">
											<xs:annotation>
												<xs:documentation>Defines a area chart that uses an xyDataset</xs:documentation>
												<xs:appinfo>net.sf.jasperreports.charts.JRChart (chartType=xyArea)</xs:appinfo>
											</xs:annotation>
										</xs:alternative>
										<xs:alternative test="@chartType = 'xyBar'" type="BarChart">
											<xs:annotation>
												<xs:documentation>Defines a bar chart that uses an xyDataset</xs:documentation>
												<xs:appinfo>net.sf.jasperreports.charts.JRChart (chartType=xyBar)</xs:appinfo>
											</xs:annotation>
										</xs:alternative>
										<xs:alternative test="@chartType = 'xyLine'" type="LineChart">
											<xs:annotation>
												<xs:documentation>Defines a line chart that uses an xyzDataset</xs:documentation>
												<xs:appinfo>net.sf.jasperreports.charts.JRChart (chartType=xyLine)</xs:appinfo>
											</xs:annotation>
										</xs:alternative>
										<xs:alternative test="@chartType = 'timeSeries'" type="TimeSeriesChart"/>
										<xs:alternative test="@chartType = 'meter'" type="MeterChart"/>
										<xs:alternative test="@chartType = 'thermometer'" type="ThermometerChart"/>
										<xs:alternative test="@chartType = 'multiAxis'" type="MultiAxisChart"/>
										<xs:alternative test="@chartType = 'stackedArea'" type="AreaChart">
