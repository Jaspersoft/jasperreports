												<xs:appinfo>net.sf.jasperreports.charts.JRChart (chartType=bar)</xs:appinfo>
											</xs:annotation>
										</xs:alternative>
										<xs:alternative test="@chartType = 'bubble'" type="BubbleChart"/>
										<xs:alternative test="@chartType = 'candlestick'" type="CandlestickChart"/>
										<xs:alternative test="@chartType = 'highLow'" type="HighLowChart"/>
										<xs:alternative test="@chartType = 'line'" type="LineChart">
											<xs:annotation>
												<xs:documentation>Defines a line chart</xs:documentation>
												<xs:appinfo>net.sf.jasperreports.charts.JRChart (chartType=line)</xs:appinfo>
