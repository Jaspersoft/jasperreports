		<xs:attribute name="keepTogether" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that prevents the group from splitting on two separate pages/columns, but only on the first break attempt.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="minDetailsToStartFromTop" type="xs:int">
			<xs:annotation>
				<xs:documentation>Minimum number of details to be rendered on the current column, to avoid starting the group on a new column.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="minHeightToStartNewPage" type="xs:int">
			<xs:annotation>
				<xs:documentation>Minimum amount of vertically space needed at the bottom of the column in order to place the group header on the current column.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="name" type="xs:string">
			<xs:annotation>
				<xs:documentation>Name of the group.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="preventOrphanFooter" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that prevents the group from appearing alone at the top of a new page/column.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="reprintHeaderOnEachColumn" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that signals if the group header should be reprinted at the beginning of each column, in vertically filled reports only.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="reprintHeaderOnEachPage" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that signals if the group header should be reprinted at the beginning of each page.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="resetPageNumber" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that signals if the group header should be printed always on a new page, along with the re-initialization of the page number.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="startNewColumn" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that signals if the group header should be printed always on a new column.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="startNewPage" type="xs:boolean">
			<xs:annotation>
				<xs:documentation>Flag that signals if the group header should be printed always on a new page.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="GroupCell">
