				<codeExpression><![CDATA["OKAPI-128"]]></codeExpression>
			</component>
		</element>
		<!-- module width set and the symbol fits: drawn at exactly that width -->
		<element kind="component" key="code128Set" uuid="6c1f0a52-3d3e-4f5c-9a0e-2a54b9f1c103" x="260" y="0" width="250" height="50" style="Barcode">
