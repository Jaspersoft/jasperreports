	<style name="Rotated" fontName="DejaVu Sans" fontSize="8.0" rotation="Right" hImageAlign="Right"/>
	<title height="760">
		<!-- no module width: the symbol fills the element width -->
		<element kind="component" key="code128Fit" uuid="6c1f0a52-3d3e-4f5c-9a0e-2a54b9f1c102" x="0" y="0" width="250" height="50" style="Barcode">
